                <div className="job-row" key={item.title}><div className="company-icon"></div><div className="job-info"><strong>{item.title}</strong><small>{item.company}</small></div><span className="status">{item.status}</span></div>
              ))}
            </div>
          </section>
        )}

        {page === "Resume" && (
          <section className="page-content">
            <span className="eyebrow">CAREER TOOLKIT</span>
            <h1>Resume Builder</h1>
            <p className="page-sub">Create and download your professional resume.</p>

            <form className="panel resume-form" onSubmit={(event) => {
              event.preventDefault();
              const form = new FormData(event.currentTarget);
              const resume = [
                form.get("name"),
                form.get("email"),
                form.get("phone"),
                "",
                "CAREER OBJECTIVE",
                form.get("objective"),
                "",
                "EDUCATION",
                form.get("education"),
                "",
                "TECHNICAL SKILLS",
                form.get("skills"),
                "",
                "PROJECTS",
                form.get("projects"),
                "",
                "CERTIFICATIONS",
                form.get("certifications")
              ].join("\n");
              const doc = new jsPDF();
doc.setFont("helvetica", "normal");
doc.setFontSize(11);

const lines = doc.splitTextToSize(resume, 170);
let y = 20;

lines.forEach((line) => {
  if (y > 275) {
    doc.addPage();
    y = 20;
  }
  doc.text(line, 20, y);
  y += 7;
});

doc.save("SkillPath-Resume.pdf");
            }}>
              <div className="form-grid">
                <label>Full name<input name="name" placeholder="Enter your full name" required /></label>
                <label>Email address<input name="email" type="email" placeholder="you@example.com" required /></label>
                <label>Phone number<input name="phone" type="tel" placeholder="Enter phone number" /></label>
                <label>Education<input name="education" placeholder="Degree, college, year" required /></label>
              </div>

              <label>Career objective
                <textarea name="objective" rows="3" placeholder="Write a short professional objective..." required />
              </label>
              <label>Technical skills
                <textarea name="skills" rows="3" placeholder="Python, Java, Machine Learning..." required />
              </label>
              <label>Projects
                <textarea name="projects" rows="4" placeholder="Project name and a short description..." />
              </label>
              <label>Certifications
                <textarea name="certifications" rows="3" placeholder="Courses and certifications..." />
              </label>

              <button className="primary" type="submit">Download Resume</button>
            </form>
          </section>
        )}
          {page === "Resume Analyzer" && (
          <section className="page-content resume-analyzer">
            <span className="eyebrow">CAREER TOOLKIT</span>
            <h1>Resume Analyzer</h1>
            <p className="page-sub">
              Discover your current skills and find what to learn for your target career.
            </p>

            <form className="panel analyzer-upload" onSubmit={analyzeResume}>
              <label>
                Target career
                <select
                  value={targetRole}
                  onChange={(event) => {
                    setTargetRole(event.target.value);
                    setAnalysis(null);
                  }}
                >
                  {Object.keys(roleSkills).map((role) => (
                    <option key={role} value={role}>{role}</option>
                  ))}
                </select>
              </label>

              <label>
                Upload your resume (PDF or DOCX)
                <input
                  type="file"
                  accept=".pdf,.docx"
                  onChange={(event) => {
                    setResumeFile(event.target.files?.[0] || null);
                    setAnalysis(null);
                    setAnalysisError("");
                  }}
                />
              </label>

              {resumeFile && <p className="page-sub">Selected: {resumeFile.name}</p>}

              <button className="primary" type="submit" disabled={analyzing}>
                {analyzing ? "Analyzing..." : "Analyze My Resume"}
              </button>

              {analysisError && <p className="analyzer-error">{analysisError}</p>}
            </form>

            {analysis && (
              <div className="analyzer-results">
                <div className="panel analyzer-score">
                  <span className="eyebrow">CAREER MATCH</span>
                  <h2>{analysis.match}%</h2>
                  <p>Your resume matches {analysis.role} requirements for {analysis.found.length} of {roleSkills[analysis.role].length} listed skills.</p>
                  <div className="analyzer-progress">
                    <div style={{ width: `${analysis.match}%` }} />
                  </div>
                </div>

                <div className="panel">
                  <h2>Skills found in your resume</h2>
                  <div className="skill-chip-list">
                    {analysis.detected.length > 0
                      ? analysis.detected.map((skill) => (
                        <span className="skill-chip" key={skill}>{skill}</span>
                      ))
                      : <p>No matching skills detected. Try a text-based resume.</p>}
                  </div>
                </div>

                <div className="panel">
                  <h2>Skills to learn for {analysis.role}</h2>
                  <p className="page-sub">Prioritize these skills to close your current gap.</p>
                  <div className="skill-chip-list">
                    {analysis.missing.length > 0
                      ? analysis.missing.map((skill, index) => (
                        <div className="learning-item" key={skill}>
                          <span className="skill-chip missing">
                            {index + 1}. {skill}
                          </span>
                          <a
                            href={learningResources[skill] || "https://www.google.com/search?q=" + encodeURIComponent(skill + " tutorial")}
                            target="_blank"
                            rel="noreferrer"
                          >
                            Learn this skill <span aria-hidden="true">?</span>
                          </a>
                        </div>
                      ))
                      : <span className="skill-chip">All listed skills detected!</span>}
                  </div>
                </div>

                <button className="primary" onClick={() => setPage("Find Jobs")}>
                  Explore Related Jobs
                </button>
              </div>
            )}
          </section>
        )}
      <footer>SkillPath AI  -  Intelligent Career & Skill Development Platform  -  Demo version</footer>
      </main>
    </div>
  );
}



















