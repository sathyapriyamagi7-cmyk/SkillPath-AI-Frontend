/* ===== SkillPath AI premium authentication and account UI ===== */
.auth-shell{min-height:100vh;width:100%;display:grid;grid-template-columns:minmax(0,1.05fr) minmax(420px,.95fr);background:#f7f8fc;color:#17213c;text-align:left;font-family:Inter,ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif}
.auth-showcase{position:relative;overflow:hidden;display:flex;flex-direction:column;justify-content:space-between;padding:clamp(32px,5vw,76px);color:#fff;background:radial-gradient(ellipse at 15% 85%,rgba(93,75,220,.38),transparent 42%),radial-gradient(ellipse at 85% 15%,rgba(41,163,212,.22),transparent 38%),linear-gradient(145deg,#11152f 0%,#191d45 54%,#292568 100%)}
.auth-showcase:after{content:"";position:absolute;width:420px;height:420px;border:1px solid rgba(255,255,255,.09);border-radius:50%;right:-180px;bottom:-180px;box-shadow:0 0 0 45px rgba(255,255,255,.025),0 0 0 95px rgba(255,255,255,.02);pointer-events:none}
.auth-brand{display:flex;align-items:center;gap:12px;font-size:22px;font-weight:750;letter-spacing:-.7px}
.auth-brand b,.auth-mobile-brand b{color:#a9a4ff}
.auth-brand-mark{display:grid;place-items:center;width:42px;height:42px;border-radius:14px;background:linear-gradient(135deg,#8b7cff,#5b55d9);color:white;font-size:23px;font-weight:800;box-shadow:0 8px 24px #080b294d}
.auth-hero{position:relative;z-index:1;max-width:560px;margin:55px 0}
.auth-eyebrow{font-size:11px;font-weight:800;letter-spacing:2.2px;color:#7770e8}
.auth-showcase .auth-eyebrow{color:#b9b4ff}
.auth-hero h1{font-size:clamp(38px,4.3vw,64px);font-weight:780;line-height:1.08;letter-spacing:-2.8px;margin:20px 0;color:white}
.auth-hero h1 span{color:#aaa4ff}
.auth-hero>p{max-width:470px;font-size:16px;line-height:1.85;color:#c6c9e0}
.auth-benefits{display:grid;gap:22px;margin-top:42px}
.auth-benefits>div{display:flex;align-items:center;gap:15px}
.auth-benefits>div>span{display:grid;place-items:center;width:43px;height:43px;border:1px solid #ffffff24;border-radius:13px;background:#ffffff0d;color:#c4beff;font-size:21px}
.auth-benefits strong,.auth-benefits small{display:block}
.auth-benefits strong{font-size:14px;color:#fff;margin-bottom:4px}
.auth-benefits small{font-size:12px;color:#aeb3d0}
.auth-footer-note{font-size:12px;color:#aeb3d0;letter-spacing:.2px}
.auth-form-side{display:grid;place-items:center;padding:40px clamp(22px,5vw,78px)}
.auth-card{width:100%;max-width:420px;background:transparent}
.auth-mobile-brand{display:none}
.auth-card-heading{margin-bottom:27px}
.auth-card-heading h2{font-size:29px;letter-spacing:-1px;line-height:1.25;font-weight:750;color:#171d37;margin:12px 0 9px}
.auth-card-heading p{font-size:13px;line-height:1.7;color:#7a8197}
.auth-tabs{display:grid;grid-template-columns:1fr 1fr;gap:4px;padding:5px;border-radius:12px;background:#e9ebf4;margin-bottom:25px}
.auth-tabs button{border:0;border-radius:9px;padding:11px 8px;background:transparent;color:#747b92;font-size:13px;font-weight:700;cursor:pointer}
.auth-tabs button.active{background:#fff;color:#35318e;box-shadow:0 2px 8px #1a24500c}
.auth-field{display:block;margin:0 0 18px;color:#343b56;font-size:12px;font-weight:700}
.auth-field input{display:block;box-sizing:border-box;width:100%;margin-top:8px;padding:14px 15px;border:1px solid #dfe3ef;border-radius:10px;background:#fff;color:#202641;font:400 14px inherit;outline:none;transition:border-color .2s,box-shadow .2s}
.auth-field input::placeholder{color:#a6acc0}
.auth-field input:focus{border-color:#7267e8;box-shadow:0 0 0 4px #7166e81c}
.auth-submit{display:block;width:100%;padding:14px 16px;margin-top:9px;border:0;border-radius:10px;background:linear-gradient(100deg,#5146ce,#7565ed);color:#fff;font-size:13px;font-weight:750;cursor:pointer;box-shadow:0 8px 18px #6255dc30;transition:transform .2s,box-shadow .2s}
.auth-submit:hover{transform:translateY(-1px);box-shadow:0 11px 23px #6255dc40}
.auth-submit:disabled{opacity:.65;cursor:wait;transform:none}
.auth-message{padding:12px 13px;margin:0 0 15px;border:1px solid #e0dafa;border-radius:9px;background:#f3f0ff;color:#5146a5;font-size:12px;line-height:1.5}
.auth-terms{margin-top:22px;color:#9298aa;font-size:10px;line-height:1.7;text-align:center}
.account-button{width:100%;box-sizing:border-box;border:0;text-align:left;color:inherit;font:inherit;cursor:pointer;background:transparent;border-radius:12px;transition:background .2s}
.account-button:hover{background:rgba(128,128,255,.11)}
.account-details{min-width:0;flex:1}
.account-details strong{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.account-details small{display:block}
.account-arrow{margin-left:auto;font-size:24px;opacity:.65}
.sidebar-logout{display:block;width:100%;padding:10px 14px;margin-top:5px;border:1px solid transparent;border-radius:10px;background:transparent;color:inherit;text-align:left;font:inherit;font-size:13px;cursor:pointer;opacity:.85}
.sidebar-logout:hover{background:rgba(239,68,68,.1);color:#e05252}
@media(max-width:850px){.auth-shell{grid-template-columns:1fr}.auth-showcase{display:none}.auth-form-side{min-height:100vh;padding:28px 22px}.auth-mobile-brand{display:flex;align-items:center;gap:9px;margin-bottom:48px;font-size:19px;font-weight:800}.auth-mobile-brand .auth-brand-mark{width:36px;height:36px;font-size:20px}.auth-card-heading h2{font-size:26px}}