/* ===== SkillPath AI | Modern visual refresh ===== */
:root {
  --sp-primary: #6d55e8;
  --sp-primary-dark: #5540c7;
  --sp-ink: #24213d;
  --sp-muted: #77768f;
  --sp-border: #e9e7f3;
  --sp-surface: #ffffff;
  --sp-background: #f7f7fc;
}

body {
  background: var(--sp-background);
  color: var(--sp-ink);
}

#root {
  color: var(--sp-ink);
}

/* Main workspace */
.main {
  max-width: 1600px;
  padding: 0 36px 32px;
}

.topbar {
  min-height: 78px;
  margin-bottom: 30px;
  border-bottom: 1px solid var(--sp-border);
}

.breadcrumb {
  color: #88869d;
}

.top-user {
  background: #eeebff;
  color: var(--sp-primary-dark);
  padding: 8px 14px;
  border-radius: 24px;
}

/* Sidebar */
.sidebar {
  background: #fff;
  border-right: 1px solid var(--sp-border);
  padding: 28px 18px 20px;
}

.brand {
  margin-bottom: 12px;
}

.nav-item {
  width: 100%;
  min-height: 46px;
  margin-bottom: 7px;
  padding: 12px 14px;
  border-radius: 12px;
  transition: background 0.2s ease, color 0.2s ease;
}

.nav-item:hover {
  background: #f5f2ff;
}

.nav-item.active {
  background: #eeeaff;
  color: var(--sp-primary-dark);
  box-shadow: inset 3px 0 0 var(--sp-primary);
}

/* Reusable cards and panels */
.panel,
.stat-card,
.career-card,
.form-panel,
.empty-state,
.jobs-panel {
  border: 1px solid var(--sp-border);
  border-radius: 18px;
  background: var(--sp-surface);
  box-shadow: 0 4px 18px rgba(45, 35, 100, 0.035);
}

.panel,
.stat-card,
.career-card {
  padding: 24px;
}

.stats {
  gap: 18px;
}

.stat-card {
  gap: 12px;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.stat-card:hover,
.career-card:hover {
  transform: translateY(-2px);
  box-shadow: 0 10px 26px rgba(65, 48, 140, 0.08);
}

.stat-card strong {
  color: var(--sp-ink);
}

.section-heading {
  margin: 34px 0 20px;
}

.section-heading h2,
.panel-head h2 {
  color: var(--sp-ink);
}

/* Welcome banner */
.welcome {
  border-radius: 22px;
  padding: 42px;
  background: linear-gradient(120deg, #5744bd 0%, #8069ef 65%, #a18af6 100%);
  box-shadow: 0 12px 28px rgba(94, 72, 196, 0.14);
}

.welcome p {
  max-width: 480px;
}

/* Buttons */
.primary,
.secondary,
.outline-btn,
.text-btn {
  cursor: pointer;
  transition: transform 0.18s ease, background 0.18s ease;
}

.primary {
  background: var(--sp-primary);
  color: #fff;
  border-radius: 10px;
  padding: 12px 19px;
}

.primary:hover {
  background: var(--sp-primary-dark);
  transform: translateY(-1px);
}

.secondary {
  background: #f0edff;
  color: var(--sp-primary-dark);
  border-radius: 10px;
  padding: 12px 18px;
}

.outline-btn {
  border: 1px solid #dcd5ff;
  color: var(--sp-primary-dark);
  background: #fff;
  border-radius: 10px;
  padding: 11px 17px;
}

.outline-btn:hover {
  background: #f7f5ff;
}

/* Skills */
.progress {
  height: 8px;
  background: #eeecf6;
  border-radius: 20px;
}

.progress > div {
  border-radius: 20px;
}

.skill-row {
  margin: 22px 0;
}

/* Career guidance and job listings */
.career-panel {
  border: 1px solid #e7e1ff;
  border-radius: 18px;
  background: linear-gradient(145deg, #fbfaff, #f0edff);
  padding: 26px;
}

.job-row {
  padding: 16px 0;
  border-bottom: 1px solid #efedf5;
}

.job-row:last-child {
  border-bottom: 0;
}

.match,
.status {
  border-radius: 20px;
  padding: 7px 12px;
}

/* Forms */
.form-panel {
  padding: 28px;
  gap: 20px;
}

.form-panel input,
.add-skill input,
#root input,
#root select,
#root textarea {
  border: 1px solid #dedbea;
  border-radius: 10px;
  background: #fff;
  padding: 12px 14px;
}

#root input:focus,
#root select:focus,
#root textarea:focus {
  outline: 2px solid #d8d0ff;
  border-color: var(--sp-primary);
}

/* Footer and responsive layout */
footer {
  padding: 30px 0 12px;
  color: #85839b;
}

@media (max-width: 1050px) {
