  const [analyzing, setAnalyzing] = useState(false);

  async function analyzeResume(event) {
    event.preventDefault();
    setAnalysisError("");
    setAnalysis(null);

    if (!resumeFile) {
      setAnalysisError("Please choose a PDF or DOCX resume first.");
      return;
    }

    setAnalyzing(true);
    try {
      const text = await extractResumeText(resumeFile);
      if (!text.trim()) {
        throw new Error("No readable text found. If this is a scanned PDF, try a text-based PDF or DOCX.");
      }

      const normalizedText = text.toLowerCase();
      const detected = skillKeywords.filter((skill) =>
        normalizedText.includes(skill.toLowerCase())
      );
      const required = roleSkills[targetRole];
      const found = required.filter((skill) => detected.includes(skill));
      const missing = required.filter((skill) => !detected.includes(skill));
      const match = Math.round((found.length / required.length) * 100);

      setAnalysis({ detected, found, missing, match, role: targetRole });
    } catch (error) {
      setAnalysisError(error.message || "Could not analyze this resume.");
    } finally {
      setAnalyzing(false);
    }
  }
  const menu = ["Dashboard", "My Profile", "Resume", "Resume Analyzer", "My Skills", "Find Jobs", "Career Guidance", "Applications"];

  function addSkill(event) {
    event.preventDefault();
    const name = newSkill.trim();
    if (!name) return;
    if (skills.some((skill) => skill.name.toLowerCase() === name.toLowerCase())) {
      alert("This skill already exists.");
      return;
    }
    setSkills([...skills, { name, level: 20 }]);
    setNewSkill("");
  }

  function apply(job) {
    if (!applications.some((item) => item.title === job.title)) {
      setApplications([...applications, { ...job, status: "Applied" }]);
    }
  }

  return (
    <div className="app">
      <aside className="sidebar">
        <div className="brand">
          <div className="brand-icon">S</div>
          <div>SkillPath <span className="brand-ai">AI</span>
            <small>YOUR CAREER COMPANION</small>
          </div>
        </div>

        <p className="menu-label">WORKSPACE</p>
        {menu.map((item) => (
          <button
            key={item}
            className={`nav-item ${page === item ? "active" : ""}`}
            onClick={() => setPage(item)}
          >
            {item}
          </button>
        ))}

        <div className="sidebar-bottom">
          <div className="avatar">SP</div>
          <div><strong>{profile.name}</strong><small>Student Account</small></div>
        </div>
      </aside>

      <main className="main">
        <header className="topbar">
          <div><span className="breadcrumb">Workspace / </span><strong>{page}</strong></div>
          <span className="top-user">è Career journey in progress</span>
        </header>

        {page === "Dashboard" && (
          <section>
            <div className="welcome">
              <div>
                <span className="eyebrow">YOUR FUTURE STARTS HERE</span>
                <h1>Build your future,<br />one skill at a time.</h1>
                <p>Discover your strengths, close skill gaps, and take the next step in your career.</p>
                <button className="primary" onClick={() => setPage("My Skills")}>Explore my skills </button>
              </div>
              <div className="welcome-art">
                <div className="orbit orbit-one"></div>
                <div className="orbit orbit-two"></div>
                <div className="art-center"><small>YOUR<br />POTENTIAL</small></div>
              </div>
            </div>

            <div className="section-heading">
              <div><h2>Your career overview</h2><p>A snapshot of your professional journey</p></div>
            </div>

            <div className="stats">
              <div className="stat-card"><small>Skills tracked</small><strong>{skills.length}</strong><span>Skills in your profile</span></div>
              <div className="stat-card"><small>Career goal</small><strong>{profile.goal || "Not set"}</strong><span>Your target career</span></div>
              <div className="stat-card"><small>Applications</small><strong>{applications.length}</strong><span>Jobs applied to</span></div>
            </div>

            <div className="content-grid">
              <div className="panel">
                <div className="panel-head"><div><h2>Your skills</h2><p>Keep growing every day</p></div>
                  <button className="text-btn" onClick={() => setPage("My Skills")}>View all </button>
                </div>
                {skills.slice(0, 4).map((skill) => (
                  <div className="skill-row" key={skill.name}>
                    <div className="skill-label"><span>{skill.name}</span><strong>{skill.level}%</strong></div>
                    <div className="progress"><div style={{ width: `${skill.level}%` }}></div></div>
                  </div>
                ))}
              </div>
              <div className="panel career-panel">
                <span className="career-star"></span><h2>Your next chapter</h2>
                <p>Build relevant skills and explore roles that match your interests.</p>
                <button className="secondary" onClick={() => setPage("Career Guidance")}>Explore career paths </button>
              </div>
            </div>

            <div className="panel jobs-panel">
              <div className="panel-head"><div><h2>Recommended opportunities</h2><p>Explore sample roles</p></div>
                <button className="text-btn" onClick={() => setPage("Find Jobs")}>Explore jobs </button>
              </div>
              {jobs.slice(0, 2).map((job) => (
                <div className="job-row" key={job.title}>
                  <div className="company-icon"></div>
                  <div className="job-info"><strong>{job.title}</strong><small>{job.company}  -  Sample listing</small></div>
                  <span className="match">{job.match}% match</span>
                  <button className="outline-btn" onClick={() => setPage("Find Jobs")}>View role</button>
                </div>
              ))}
            </div>
          </section>
        )}

        {page === "My Profile" && (
          <section className="page-content">
            <span className="eyebrow">ABOUT YOU</span><h1>My Profile</h1>
            <p className="page-sub">Manage your professional information and career goal.</p>
            <div className="panel form-panel">
              <label>Full name<input value={profile.name} onChange={(e) => setProfile({ ...profile, name: e.target.value })} /></label>
              <label>Email address<input type="email" placeholder="Enter your email" value={profile.email} onChange={(e) => setProfile({ ...profile, email: e.target.value })} /></label>
              <label>Target career<input value={profile.goal} onChange={(e) => setProfile({ ...profile, goal: e.target.value })} /></label>
              <button className="primary" onClick={() => alert("Profile updated for this session!")}>Save profile</button>
            </div>
          </section>
        )}

        {page === "My Skills" && (
          <section className="page-content">
            <span className="eyebrow">YOUR GROWTH</span><h1>My Skills</h1>
            <p className="page-sub">Track your abilities and add skills you want to develop.</p>
            <form className="add-skill panel" onSubmit={addSkill}>
