  { title: "Python Developer", company: "Tech Solutions", skills: ["Python", "SQL"], match: 90 },
  { title: "Machine Learning Engineer", company: "AI Labs", skills: ["Python", "Machine Learning"], match: 82 },
  { title: "Frontend Developer", company: "Digital Works", skills: ["JavaScript", "React"], match: 70 },
];

