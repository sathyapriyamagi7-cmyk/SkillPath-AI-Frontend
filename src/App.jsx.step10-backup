  "AI Engineer": ["Python", "Machine Learning", "Deep Learning", "SQL", "Data Analysis", "Git"],
  "Data Analyst": ["SQL", "Python", "Excel", "Data Analysis", "Power BI", "Statistics", "Tableau"],
  "Web Developer": ["HTML", "CSS", "JavaScript", "React", "REST API", "Git"],
  "Java Backend Developer": ["Java", "Spring Boot", "SQL", "REST API", "Git"],
  "Frontend Developer": ["HTML", "CSS", "JavaScript", "React", "Git"],
};

const skillKeywords = [
  "Python", "Java", "JavaScript", "React", "SQL", "MySQL",
  "HTML", "CSS", "Machine Learning", "Deep Learning",
  "Data Analysis", "Excel", "Power BI", "Tableau", "Git",
  "REST API", "Spring Boot", "Node.js", "Communication",
  "Problem Solving", "Statistics"
];

async function extractResumeText(file) {
  const extension = file.name.split(".").pop().toLowerCase();

  if (extension === "pdf") {
    const pdf = await pdfjsLib.getDocument({
      data: await file.arrayBuffer()
    }).promise;

    let text = "";
    for (let i = 1; i <= pdf.numPages; i++) {
      const page = await pdf.getPage(i);
      const content = await page.getTextContent();
      text += content.items.map((item) => item.str || "").join(" ") + " ";
    }
    return text;
  }

  if (extension === "docx") {
    const result = await mammoth.extractRawText({
      arrayBuffer: await file.arrayBuffer()
    });
    return result.value;
  }

  throw new Error("Please upload a PDF or DOCX resume.");
}
