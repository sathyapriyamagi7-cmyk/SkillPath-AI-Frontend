        )}

        {page === "Resume" && (
          <section className="page-content">
            <span className="eyebrow">CAREER TOOLKIT</span>
            <h1>Resume Builder</h1>
            <p className="page-sub">Create and download your professional resume.</p>

            <form className="panel resume-form" onSubmit={(event) => {
              event.preventDefault();
              const form = new FormData(event.currentTarget);
              const resume = [
                form.get("name"),
                form.get("email"),
                form.get("phone"),
                "",
                "CAREER OBJECTIVE",
                form.get("objective"),
                "",
                "EDUCATION",
                form.get("education"),
                "",
                "TECHNICAL SKILLS",
                form.get("skills"),
                "",
                "PROJECTS",
                form.get("projects"),
                "",
                "CERTIFICATIONS",
                form.get("certifications")
              ].join("\n");
              const blob = new Blob([resume], { type: "text/plain;charset=utf-8" });
              const url = URL.createObjectURL(blob);
              const link = document.createElement("a");
              link.href = url;
              link.download = "SkillPath-Resume.txt";
              link.click();
              URL.revokeObjectURL(url);
