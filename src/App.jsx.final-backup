import { useState, useEffect } from "react";
import { getUsers } from "./api";
import "./App.css";

const initialSkills = [
  { name: "Python", level: 75 },
  { name: "Java", level: 45 },
  { name: "Machine Learning", level: 60 },
  { name: "Communication", level: 80 },
];

const jobs = [
  { title: "Python Developer", company: "Tech Solutions", skills: ["Python", "SQL"], match: 90 },
  { title: "Machine Learning Engineer", company: "AI Labs", skills: ["Python", "Machine Learning"], match: 82 },
  { title: "Frontend Developer", company: "Digital Works", skills: ["JavaScript", "React"], match: 70 },
];

export default function App() {
  const [users, setUsers] = useState([]);
  const [apiError, setApiError] = useState("");

  useEffect(() => {
    getUsers()
      .then((data) => setUsers(data))
      .catch((error) => setApiError(error.message));
  }, []);
  const [page, setPage] = useState("Dashboard");
  const [skills, setSkills] = useState(initialSkills);
  const [applications, setApplications] = useState([]);
  const [newSkill, setNewSkill] = useState("");
  const [profile, setProfile] = useState({
    name: "Sathya Priya",
    email: "",
    goal: "AI Engineer",
  });

  const menu = ["Dashboard", "My Profile", "My Skills", "Find Jobs", "Career Guidance", "Applications"];

  function addSkill(event) {
    event.preventDefault();
    const name = newSkill.trim();
    if (!name) return;
    if (skills.some((skill) => skill.name.toLowerCase() === name.toLowerCase())) {
      alert("This skill already exists.");
      return;
    }
    setSkills([...skills, { name, level: 20 }]);
    setNewSkill("");
  }

  function apply(job) {
    if (!applications.some((item) => item.title === job.title)) {
      setApplications([...applications, { ...job, status: "Applied" }]);
    }
  }

  return (
    <div className="app">
      <aside className="sidebar">
        <div className="brand">
          <div className="brand-icon">S</div>
          <div>SkillPath <span className="brand-ai">AI</span>
            <small>YOUR CAREER COMPANION</small>
          </div>
        </div>

        <p className="menu-label">WORKSPACE</p>
        {menu.map((item) => (
          <button
            key={item}
            className={`nav-item ${page === item ? "active" : ""}`}
            onClick={() => setPage(item)}
          >
            {item}
          </button>
        ))}

        <div className="sidebar-bottom">
          <div className="avatar">SP</div>
          <div><strong>{profile.name}</strong><small>Student Account</small></div>
        </div>
      </aside>

      <main className="main">
        <header className="topbar">
          <div><span className="breadcrumb">Workspace / </span><strong>{page}</strong></div>
          <span className="top-user">â— Career journey in progress</span>
        </header>

        {page === "Dashboard" && (
          <section>
            <div className="welcome">
              <div>
                <span className="eyebrow">YOUR FUTURE STARTS HERE</span>
                <h1>Build your future,<br />one skill at a time.</h1>
                <p>Discover your strengths, close skill gaps, and take the next step in your career.</p>
                <button className="primary" onClick={() => setPage("My Skills")}>Explore my skills </button>
              </div>
              <div className="welcome-art">
                <div className="orbit orbit-one"></div>
                <div className="orbit orbit-two"></div>
                <div className="art-center">âœ¦<small>YOUR<br />POTENTIAL</small></div>
              </div>
            </div>

            <div className="section-heading">
              <div><h2>Your career overview</h2><p>A snapshot of your professional journey</p></div>
            </div>

            <div className="stats">
              <div className="stat-card"><small>Skills tracked</small><strong>{skills.length}</strong><span>Skills in your profile</span></div>
              <div className="stat-card"><small>Career goal</small><strong>{profile.goal || "Not set"}</strong><span>Your target career</span></div>
              <div className="stat-card"><small>Applications</small><strong>{applications.length}</strong><span>Jobs applied to</span></div>
            </div>

            <div className="content-grid">
              <div className="panel">
                <div className="panel-head"><div><h2>Your skills</h2><p>Keep growing every day</p></div>
                  <button className="text-btn" onClick={() => setPage("My Skills")}>View all </button>
                </div>
                {skills.slice(0, 4).map((skill) => (
                  <div className="skill-row" key={skill.name}>
                    <div className="skill-label"><span>{skill.name}</span><strong>{skill.level}%</strong></div>
                    <div className="progress"><div style={{ width: `${skill.level}%` }}></div></div>
                  </div>
                ))}
              </div>
              <div className="panel career-panel">
                <span className="career-star">âœ¦</span><h2>Your next chapter</h2>
                <p>Build relevant skills and explore roles that match your interests.</p>
                <button className="secondary" onClick={() => setPage("Career Guidance")}>Explore career paths â†’</button>
              </div>
            </div>

            <div className="panel jobs-panel">
              <div className="panel-head"><div><h2>Recommended opportunities</h2><p>Explore sample roles</p></div>
                <button className="text-btn" onClick={() => setPage("Find Jobs")}>Explore jobs </button>
              </div>
              {jobs.slice(0, 2).map((job) => (
                <div className="job-row" key={job.title}>
                  <div className="company-icon">âœ¦</div>
                  <div className="job-info"><strong>{job.title}</strong><small>{job.company}  -  Sample listing</small></div>
                  <span className="match">{job.match}% match</span>
                  <button className="outline-btn" onClick={() => setPage("Find Jobs")}>View role</button>
                </div>
              ))}
            </div>
          </section>
        )}

        {page === "My Profile" && (
          <section className="page-content">
            <span className="eyebrow">ABOUT YOU</span><h1>My Profile</h1>
            <p className="page-sub">Manage your professional information and career goal.</p>
            <div className="panel form-panel">
              <label>Full name<input value={profile.name} onChange={(e) => setProfile({ ...profile, name: e.target.value })} /></label>
              <label>Email address<input type="email" placeholder="Enter your email" value={profile.email} onChange={(e) => setProfile({ ...profile, email: e.target.value })} /></label>
              <label>Target career<input value={profile.goal} onChange={(e) => setProfile({ ...profile, goal: e.target.value })} /></label>
              <button className="primary" onClick={() => alert("Profile updated for this session!")}>Save profile</button>
            </div>
          </section>
        )}

        {page === "My Skills" && (
          <section className="page-content">
            <span className="eyebrow">YOUR GROWTH</span><h1>My Skills</h1>
            <p className="page-sub">Track your abilities and add skills you want to develop.</p>
            <form className="add-skill panel" onSubmit={addSkill}>
              <input placeholder="Enter a skill, e.g. SQL" value={newSkill} onChange={(e) => setNewSkill(e.target.value)} />
              <button className="primary" type="submit">+ Add skill</button>
            </form>
            <div className="panel">
              {skills.map((skill, index) => (
                <div className="skill-row" key={skill.name}>
                  <div className="skill-label"><span>{skill.name}</span><strong>{skill.level}%</strong></div>
                  <input type="range" min="0" max="100" value={skill.level} onChange={(e) => setSkills(skills.map((item, i) => i === index ? { ...item, level: Number(e.target.value) } : item))} />
                  <div className="progress"><div style={{ width: `${skill.level}%` }}></div></div>
                </div>
              ))}
            </div>
          </section>
        )}

        {page === "Find Jobs" && (
          <section className="page-content">
            <span className="eyebrow">YOUR NEXT OPPORTUNITY</span><h1>Find Jobs</h1>
            <p className="page-sub">Explore sample roles and their required skills.</p>
            <div className="job-list panel">
              {jobs.map((job) => {
                const applied = applications.some((item) => item.title === job.title);
                return <div className="job-card" key={job.title}>
                  <div className="company-icon">âœ¦</div>
                  <div className="job-info"><strong>{job.title}</strong><small>{job.company}  -  Sample listing</small>
                    <div className="chips">{job.skills.map((skill) => <span key={skill}>{skill}</span>)}</div>
                    <small>Illustrative match score: {job.match}%</small>
                  </div>
                  <button className={applied ? "secondary" : "primary"} disabled={applied} onClick={() => apply(job)}>{applied ? "Applied âœ“" : "Apply"}</button>
                </div>;
              })}
            </div>
            <p className="disclaimer">These are sample listings, not live vacancies.</p>
          </section>
        )}

        {page === "Career Guidance" && (
          <section className="page-content">
            <span className="eyebrow">PLAN YOUR FUTURE</span><h1>Career Guidance</h1>
            <p className="page-sub">Explore career paths and skills to develop.</p>
            <div className="guidance-grid">
              {[
                { title: "AI / ML Engineer", skills: "Python, Mathematics, Machine Learning" },
                { title: "Web Developer", skills: "HTML, CSS, JavaScript, React" },
                { title: "Data Analyst", skills: "SQL, Python, Statistics, Visualization" },
              ].map((career) => (
                <div className="panel career-card" key={career.title}>
                  <span className="stat-symbol purple">âœ§</span><h2>{career.title}</h2><p>Skills to explore</p>
                  <div className="chips">{career.skills.split(", ").map((skill) => <span key={skill}>{skill}</span>)}</div>
                  <button className="secondary" onClick={() => { setProfile({ ...profile, goal: career.title }); setPage("My Profile"); }}>Set as career goal â†’</button>
                </div>
              ))}
            </div>
          </section>
        )}

        {page === "Applications" && (
          <section className="page-content">
            <span className="eyebrow">YOUR JOB SEARCH</span><h1>Applications</h1>
            <p className="page-sub">Track roles you have applied to in this session.</p>
            <div className="panel">
              {applications.length === 0 ? (
                <div className="empty-state"><h2>No applications yet</h2><p>Explore sample jobs and click Apply to see them here.</p>
                  <button className="primary" onClick={() => setPage("Find Jobs")}>Browse jobs</button>
                </div>
              ) : applications.map((item) => (
                <div className="job-row" key={item.title}><div className="company-icon">âœ¦</div><div className="job-info"><strong>{item.title}</strong><small>{item.company}</small></div><span className="status">{item.status}</span></div>
              ))}
            </div>
          </section>
        )}

        <footer>SkillPath AI  -  Intelligent Career & Skill Development Platform  -  Demo version</footer>
      </main>
    </div>
  );
}


